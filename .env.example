PORT=3000

# Database — local : champs séparés ci-dessous.
# Prod (Neon, etc.) : définir plutôt DATABASE_URL (une seule URL + SSL), qui prime.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
DB_HOST=localhost
DB_PORT=5432
EXTERNAL_DB_PORT=5433
DB_USER=garden
DB_PASSWORD=secret
DB_NAME=gardenmate

# JWT
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me

# CORS (origine autorisée en prod)
CORS_ORIGIN=http://localhost:3000

# Secret de l'endpoint interne de rappels (header x-internal-secret)
REMINDERS_SECRET=change_me
